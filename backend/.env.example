# NEXUS R3 backend configuration.
# Copy to .env and adjust. NEVER commit the real .env.

# PostgreSQL connection (matches backend/docker-compose.yml defaults).
DATABASE_URL=postgresql+psycopg://nexus:nexus@localhost:5432/nexus

# Comma-separated list of allowed CORS origins (R4 dev server, Streamlit, etc.).
# Never use "*" in anything resembling production.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8501
