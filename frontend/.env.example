# NEXUS Tactical GIS — map tile configuration (names only, never real keys).
# Copy this file to .env (gitignored) and fill in ONLY what you need.
# All variables are optional: with everything unset the map uses the
# keyless CARTO Dark Matter tiles.

# Optional: tile URL template. Default when unset (keyless, no API key):
#   https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
# Keyless alternative (OpenStreetMap standard, lighter style):
#   https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Keyed providers: include an {apikey} placeholder in the URL and set
# VITE_MAP_API_KEY below. Examples:
#   MapTiler:      https://api.maptiler.com/maps/dataviz-dark/{z}/{x}/{y}.png?key={apikey}
#   Thunderforest: https://{s}.tile.thunderforest.com/transport-dark/{z}/{x}/{y}.png?apikey={apikey}
#VITE_MAP_TILES_URL=

# Optional: API key for providers that require one. Only used when
# VITE_MAP_TILES_URL contains the {apikey} placeholder. Leave empty for
# CARTO / OSM (they need no key).
# NOTE: values here are compiled into the browser bundle — use a
# browser-allowed key with domain restrictions from your provider.
VITE_MAP_API_KEY=

# Optional: attribution HTML override (should credit the tile provider).
#VITE_MAP_TILES_ATTRIBUTION=

# Optional: maximum tile zoom level (default 19).
#VITE_MAP_MAX_ZOOM=19
